code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled, fog_disabled;

uniform vec4 ColorParameter : source_color;
uniform vec2 Scale;
uniform vec2 Speed;
uniform sampler2D tex_frg_3;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Vector2Parameter:9
	vec2 n_out9p0 = Scale;


// UVFunc:10
	vec2 n_in10p2 = vec2(0.00000, 0.00000);
	vec2 n_out10p0 = (UV - n_in10p2) * n_out9p0 + n_in10p2;


// Input:4
	float n_out4p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Speed;


// VectorOp:8
	vec2 n_out8p0 = vec2(n_out4p0) * n_out7p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, 1.00000);
	vec2 n_out5p0 = n_out8p0 * n_in5p1 + n_out10p0;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out5p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out3p0.x;


}
