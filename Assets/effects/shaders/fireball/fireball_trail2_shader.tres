uniform sampler2D Color_Texture;
uniform vec2 Trail_Speed;
uniform sampler2D tex_frg_2;



void fragment() {
	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Color_Texture, UV);
	float n_out8p4 = n_out8p0.a;


// Input:3
