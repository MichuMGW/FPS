// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// FloatOp:9
	float n_out9p0 = n_out8p4 * n_out2p0.x;


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out9p0;


}
"
